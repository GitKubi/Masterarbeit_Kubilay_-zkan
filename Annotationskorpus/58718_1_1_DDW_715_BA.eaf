        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46"
                TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>Eine deutsche Industriestadt empfängt einen großen Soldaten. Die schaffende Bevölkerung begrüßt Generalmajor Graf von Strachwitz, Träger des Eichenlaubs mit Schwertern und Brillanten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47"
                TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>Das Modell eines Strachgeschützes, das von den Angehörigen unseres Werkes hergestellt wurde, überreichen wir Ihnen zur Erinnerung am Besuch in unserem Werk. Bitte schön, Herr General.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48"
                TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>Also, ich bedanke mich. Ich bedanke mich.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49"
                TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>Es freut mich ganz besonders, dass ich Ihnen hier allen die Grüße und den Dank der Front sagen darf, den Dank von unseren tapferen Soldaten, die hier draußen kämpfen, mit euren Geschützern.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50"
                TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>Wir draußen an der Front haben die Aufgaben, die Heimat zu schützen und ihr liefert uns die vorzüglichen Waffen, mit denen wir heute den Feind unbedingt schlagen werden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51"
                TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>Wir Soldaten sind davon fest überzeugt und wir versprechen euch, dass wir eure Heimat schützen werden und alles dran setzen werden und kämpfen werden bis zum letzten Blutstropfen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52"
                TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>Die europabewusste französische Jugend erklärt sich in einer Großkundgebung zum Kampf gegen den jüdisch-plutokratisch-bolschewistischen Weltfeind bereicht.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
