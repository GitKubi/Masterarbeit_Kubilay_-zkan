    <TIER LINGUISTIC_TYPE_REF="Content_Type" PARENT_REF="Segment" TIER_ID="Content">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE> Staatsfeier, Bukarest, Rumänien, 1942. Wilhelm List trifft als Vertreter von Adolf Hitler zum rumänischen Nationalfeiertag in Bukarest ein. Ehrenformation und gemeinsame Parade rumänischer und deutscher Truppen vor zahlreichen Zuschauern</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a121" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>400 niederländische Freiwillige werden für den Arbeitsdienst vereidigt, leisten den Schwur auf Hitler und werden für einen Einsatz an der Ostfront verpflichtet</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>Aufrüstung, Deutsches Reich, 1942. Eingliederung des Baustabs Speer in die Organisation Todt; Bau und Präsentation neuer Rüstungswerke sowie Montage von Kampfflugzeugen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a123" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>Seekrieg, Deutsches Reich, 1942. Rückkehr einer U-Boot-Besatzung nach erfolgreichem Einsatz gegen die USA; feierlicher Empfang und Auszeichnung der Besatzung. Anschließend empfängt Hitler die U-Boot-Kommandanten Hardegen und Topp und verleiht ihnen das Eichenlaub zum Ritterkreuz</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>Adolf Hitler, Führerhauptquartier Wolfsschanze bei Rastenburg, Ostpreußen, Deutsches Reich, 1942. Hitler wird im Park des Führerhauptquartiers in einer privaten Alltagssituation beim Spielen mit seinem Schäferhund Blondi gezeigt</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a148" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>Kampfhandlungen, Sowjetunion, 1942. Deutsch-finnische Kampfhandlungen unter winterlichen Bedingungen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a149" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>Logistik, Sowjetunion, 1942. Eröffnung einer neuen Eisenbahnbrücke über die Narva</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a150" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>Logistik, Sowjetunion, 1942. Deutsche Nachschubkolonnen auf schlechten sowjetischen Straßen. Organisation Todt und sowjetische Arbeitskräfte bessern Straßen aus und errichten Behelfsfahrbahnen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>Beginn der Kämpfe um Kertsch und um die Landzunge von Parpatsch am 8.Mai, Krim, Ostfront, UdSSR, 1942.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
