                <ANNOTATION_VALUE>Ihnen folgen die Männer der Organisation Todt und des Reichsarbeitsdienstes und schaffen</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117"
                TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>schleunigst Wiederordnung.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118"
                TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts253">
                <ANNOTATION_VALUE>Die schnelle Wiederherstellung von Bahnanlagen und Straßen ist für den Nachschub von größter</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119"
                TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>Wichtigkeit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120"
                TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>Neben den völlig ausgefahrenen und verwahrlosen Sowjetsstraßen entstehen neue feste Rollbahnen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121"
                TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>Hier wird unter geschickter Ausnutzung zerstörter Pulkenteile ein neuer Übergang geschaffen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122"
                TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>Reichsminister Generalmajor Doktor Todt bei seinen Männern.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123"
                TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>In kurzer Zeit ist das Werk vollendet, die Brücke befahrbar.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124"
                TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>In endlosen Kolonnen rollt der Nachschub heran.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125"
                TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>Der Bedarf der kämpfenden und marschierenden Truppe an Munition, an Kriegsgerät und Verpflegung</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126"
                TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>ist gewaltig.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127"
                TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Sturmgeschütze gehen in Stellung.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128"
                TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>Sie sollen den Angriff unserer Infanterie auf eine Bunkerlinie ostwärts von U-Mann unterstützen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129"
                TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>Eine Beobachtungsstelle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130"
                TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Während der Artillerievorbereitung stellt sich die Infanterie bereit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131"
                TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>In vorderster Linie Feuer auf die gut getarnten Bunker.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132"
                TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>Ein bolschewistischer Offizier, der kurz zuvor gefangen genommen wurde.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133"
                TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>Die Sturmgeschütze schieben sich immer dichter an die Bunkerlinie heran.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134"
                TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>Die ersten Bunker sind niedergekämpft.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135"
                TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>Überlebende der Besatzung kommen heraus und geben sich gefangen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136"
                TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>Auch hier wieder Frauen unter den Gefangenen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137"
                TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>So strömen an zahllosen Stellen der Front immer neue Massen von Gefangenen in die vorbereiteten</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138"
                TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Sammellager.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139"
                TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>Sowjetische Bomber versuchen anzugreifen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140"
                TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>Alarm bei der Flakartillerie.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141"
                TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Die Sprengpunkte liegen gut.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142"
                TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>Meiner ist getroffen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143"
                TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>Und wieder ist einer getroffen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144"
                TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts311">
                <ANNOTATION_VALUE>Smolensk.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145"
                TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>Auch diese Stadt ist auf Befehl Stallings von den bolschewistischen Mordbrennern fast</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146"
                TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>völlig zerstört worden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147"
                TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>Aus Häusern und Straßen wurden Ruinenfelder.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148"
                TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>Trotzdem erklärten London und Moskau noch vier Wochen nach der Einnahme von Smolensk</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149"
                TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>durch deutsche Tropen, dass sich dieser wichtige Verkehrs- und Eisenbahnknotenpunkt nach wie</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150"
                TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>vor in der Hand der Bolschewisten befinde.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151"
                TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>Unsere Aufnahmen widerlegen aufs Neue diese plumpe Lüge.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152"
                TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>Die Kathedrale von Smolensk, die Sowjets hatten sie als gottlosen Museum eingerichtet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153"
                TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>Sowjetsoldaten müssen die Kirchen säubern.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154"
                TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts333">
                <ANNOTATION_VALUE>Und hier eine Kirche, deren Turm als falscher Umsprung gerüst zur Volksbelustigung diente.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155"
                TIME_SLOT_REF1="ts334" TIME_SLOT_REF2="ts335">
                <ANNOTATION_VALUE>Die Bevölkerung begrüßt die deutschen Soldaten als Befreier vom bolschewistischen Joch.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156"
                TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>Ein Frontsoldat lässt sich ferntrauen, zwei seiner Kameraden als Trauzeugen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157"
                TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>Die Kompanie dem frisch gebackenen Ehemann.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158"
                TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>Ostwärts zu Smolensk sind die Sowjets zu neuem Kampf gestellt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159"
                TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>Feindliche Panzer versuchen den deutschen Vormarsch aufzuhalten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160"
                TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>In direktem Beschuss werden sie niedergekämpft.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161"
                TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>Artillerie eröffnet den Angriff auf eine größere Ortschaft.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162"
                TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>Ein vor der Stadt liegender Höhenzug ist genommen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163"
                TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>Dieser Panzer blieb auf der Flucht stecken.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164"
                TIME_SLOT_REF1="ts356" TIME_SLOT_REF2="ts357">
                <ANNOTATION_VALUE>Die Besatzung, die sich nicht ergeben wollte, wird herausgeholt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165"
                TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts359">
                <ANNOTATION_VALUE>Eine neue Umfassung von Sowjetverbänden im Raume von Smolensk wird eingeleitet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166"
                TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>Panzer stoßen vor.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167"
                TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts363">
                <ANNOTATION_VALUE>Am Wege brennende Dörfer, in denen sich die Sowjets verzweifelt zur Wehr setzten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168"
                TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts365">
                <ANNOTATION_VALUE>Generaloberst Guderian, er führt seine Panzerverbände heran, um die Einschließung zu verlenden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169"
                TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts367">
                <ANNOTATION_VALUE>Unsere Panzer und Sturmgeschütze überwinden alle Hindernisse.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170"
                TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>Der Ring ist geschlossen. Generaloberst Guderian nimmt die Meldung darüber entgegen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171"
                TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts371">
                <ANNOTATION_VALUE>Das ist eine der Rückzugsstraßen der Bolschewicken.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172"
                TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts373">
                <ANNOTATION_VALUE>Die zurückgehenden Kolonnen wurden von unserer Artillerie und unserer Luftwaffe völlig vernichtet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173"
                TIME_SLOT_REF1="ts374" TIME_SLOT_REF2="ts375">
                <ANNOTATION_VALUE>Aus den umliegenden Wäldern und Feldern werden die Bolschewisten herausgeholt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174"
                TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>Ihre Kampfkraft ist gebrochen. Das deutsche Schwert schlug hart und unerbittlich zu.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175"
                TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>In kleineren Trupps werden sie nun den Gefangenensammellagern zugeführt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176"
                TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>Die Fratze des Bolschewismus. Für den Sieg dieser Untermenschen wird in den englischen Kirchen und Kathedralen gebetet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177"
                TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts385">
                <ANNOTATION_VALUE>Vormarsch nordostwärts des Peipussees.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178"
                TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts387">
                <ANNOTATION_VALUE>Das Gelände wird von versprengten Bolschewicken gesäubert. Eine Brücke fliegt in die Luft.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179"
                TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>Im letzten Augenblick gelangt dem Bolschewisten dieses Zerstörungswerk.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180"
                TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE>Die Spitze unserer Truppen muss dem Chaga mit Flusssäcken überwinden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181"
                TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>Jenseits des Flusses verlassen es sowjetische Stellungen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182"
                TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>Der Feind ist weit zurückgedrängt. Die einzelnen Verbände setzen planmäßig über.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183"
                TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>Schwere Waffen werden mit Fähren übergesetzt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184"
                TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>Die Pioniere sind heran und schlagen eine neue Brücke.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185"
                TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts401">
                <ANNOTATION_VALUE>Der Brückenschlag schreitet schnell vorwärts. Jeder Pionier gibt sein Bestes um das Werk so schnell wie möglich zu verlenden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186"
                TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>Als erste rollen Sturmgeschütze hinüber. Der Anschluss nach vorn ist wieder hergestellt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187"
                TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>Die Spitze ist auf stark befestigte Stellungen des Gegners gestoßen. Die Infanteristen graben sich ein.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188"
                TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>Erst müssen Stukas die Befestigungen sturmreif werfen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189"
                TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>Jede schweren Bomben tragen Tod und Verderben in die Reihen der Sowjets.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190"
                TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>Schwere Artillerie greift in den Kampf ein.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191"
                TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts413">
                <ANNOTATION_VALUE>Die Infanterie geht vor und öffnet die Straße für die nachfolgenden Verbände.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192"
                TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts415">
                <ANNOTATION_VALUE>Diese Bolschewisten sind aus ihren Feldstellungen herausgeholt worden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193"
                TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>Verwundeten transport über den Peipussee. Durch diese Wassertransporte werden große Umwege vermieden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194"
                TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts419">
                <ANNOTATION_VALUE>Den Verwundeten werden die Erschütterungen einer Fahrt über die verwahrlosen Sowjetsstraßen erspart.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195"
                TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>Deutsche Kampfflugzeuge im Anflug gegen Moskau.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196"
                TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts423">
                <ANNOTATION_VALUE>In der Abenddämmerung geht es im geschlossenen Verband auf die sowjetische Hauptstadt zu.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197"
                TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts425">
                <ANNOTATION_VALUE>Feuerstöße auf bolschewistische Flaggstellungen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198"
                TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts427">
                <ANNOTATION_VALUE>Unten herrscht bereits völlige Dunkelheit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199"
                TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>Das ist Moskau. Einschläge von Sprengbomben aller Kaliber. Die Brände sind nicht mehr zu zählen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200"
                TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>Eines der großen Moskauer Flugzeugwerke. Es steht in hellen Flammen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201"
                TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>Fast jede Nacht verspürt Moskau die harten Schläge der deutschen Luftwaffe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
