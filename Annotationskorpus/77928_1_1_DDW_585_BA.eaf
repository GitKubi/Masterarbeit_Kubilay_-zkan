        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a146" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>Vorführung von „Frau Luna“ im Theater des Volkes vor verwundeten Soldaten</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
