        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>Im Berliner Rathaus fand eine Feierstunde für den Altmeister der Berliner Operette den Komponisten Paul Linke statt, der in diesen Tagen seinen 75. Geburtstag beging.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>Im Auftage des Führers überreichte ihm Reisminister Dr. Goebbels die Goethe-Medaille.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Der Kommissarische Oberbürgermeister der Reishauptstadt Ludwig Steck legt Paul Linke, der an diesem Tage zum Ehrenbürger der Stadt Berlin ernannt wurde, die goldene Ehrenkette um.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Eine Auszeichnung, die nur den um die Reishauptstadt besonders verdienten Männern verliehen wird.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>Am Abend dieses Tages wurde im Theater des Volkes Paul Linke's bekannteste Berliner Operette Frau Luna vor verwundeten Soldaten und Rüstungsarbeitern aufgeführt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>In den südlichen Gauern des Reiches untergebracht.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>Dieser Zug bringt die kleine Gesellschaft zum Teil mit ihren Müttern von der Nordseeküste nach dem Semmering.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>Berger und Thela, eine neue Welt tut sich auf.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>Hier lagert Tabak für 800 Millionen Zigaretten. Aufbereitung des Tabaks für die Fabrikation.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>Der aufbereitete Tabak wird durch Saugluft entstaubt und eine Mischkarussell zugeführt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>In diesem Mischkarussell werden nach einem genauen Rezept 32 verschiedene Tabaksorten aus dem Orient und dem Balkan gemischt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17"
                TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>Die nächste Etappe ist die Schneidemaschine. Die Tabakblätter werden hier zu feinen Streifen geschnitten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>Die eigentliche Fabrikation beginnt. Eine unendliche Zigarette. Im Bruchteil einer Sekunde ist sie zerschnitten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>Diese Maschine liefert täglich eine halbe Million Zigaretten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>In der Packmaschine. Alles geht automatisch.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21"
                TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>So werden allein in dieser Fabrik täglich 10 Millionen Zigaretten hergestellt. 60 Prozent davon gehen an die Front.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22"
                TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>Reismaschall Hermann Göring überreicht in seinem Hauptquartier Soldaten der Luftwaffe, die sich durch hervorragende Tapferkeit auszeichneten, das Ritterkreuz des Eisernenkreuzes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23"
                TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>Das Ritterkreuz ist der Ritterkreuz des Eisernenkreuzes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>Das Ritterkreuz ist der Ritterkreuz des Eisernenkreuzes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25"
                TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>An der finnischen Front.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26"
                TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>Marschpause in Ostkarelien. General Feige zeichnet besonders bewährte finnische Soldaten mit dem Eisernen Kreuz aus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27"
                TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>Nach der Oberung von Enis Lina wird Ostkarelien planmäßig von den Bolschewicken gesäubert.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28"
                TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>Die Sowjets haben sich in den dichten Urwäldern festgesetzt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29"
                TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>In vielen Einzelgefechten müssen sie aus ihren Stellungen herausgeholt werden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30"
                TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>Wieder ist in erbittertem Kampf Mann gegen Mann ein Widerstandsnest ausgeräuchert worden. Die überlebenden Bolschewicken gaben sich gefangen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31"
                TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>Ein schmaler Waldpfad ist frei gekämpft. Die Truppe rückt weiter vor.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32"
                TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>Im Raum um Leningrad. Die Flussbrücken, über die der deutsche Nachschub geführt wird, werden jetzt durch mächtige Eisbrecher gesichert.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33"
                TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>Die Holzkonstruktionen werden mit schweren Feldsteinen ausgefüllt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34"
                TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>Frisch Fleisch für einen schlechten Reizuch. Es handelt sich zum großen Teil um herrenloses Schlachtvieh, das in zerstörten Dörfern hummernd umherirrte.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35"
                TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>Neue, warme Wintersachen für die Front sind eingetroffen. Sie werden sofort von gefangenen Bolschewicken in Lastkraftwagen umgeladen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36"
                TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>Und hier Verpflegung für die kämpfende Truppe vor Leningrad.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37"
                TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts91">
                <ANNOTATION_VALUE>Diese Winterquartiere schützen gegen die Kälte.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38"
                TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>Ein Schneebad ist eine gute Apertung.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39"
                TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>Neue Schaftpelze. Auch für den Winter geschieht, was geschehen kann. Weiße Tarnhämten für den Kampf im Schnee.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40"
                TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>Ausrüstungen für Posten und Beobachter.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41"
                TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>Spätrupptätigkeit im Raum von Leningrad.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42"
                TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>In den vorossenen Stellungen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43"
                TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>In den vorossenen Stellungen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44"
                TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>In den vorossenen Stellungen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45"
                TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts109">
                <ANNOTATION_VALUE>Vollschewistische Überläufer.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46"
                TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts113">
                <ANNOTATION_VALUE>Vor Moskau.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47"
                TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>Generalobost Freier von Weix, der in diesen Tagen sein 60. Lebensjahr verländete. Die Divisionen und Armee-Kurs des Freiern von Weix zeichneten sich in Polen, an der Westfront und auch im Balkan besonders aus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48"
                TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>Im Kampf gegen die Sowjetunion waren sie unter anderem an den Vernichtungsschlachten von Kiew und Triansk maßgebend beteiligt. Auszeichnung verdienter Soldaten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49"
                TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>Das Deutsche Kreuz ist vom Führer für vielfach bewiesene außergewöhnliche Tapferkeit gestiftet worden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50"
                TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>Angriff auf eine tiefgegliederte Stellung der Bolschewicke nördlich von Moskau. Sie gehört zum äußeren Verteidigungskürtel der sowjetischen Hauptstadt und ist stark befestigt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51"
                TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>Infanterie und Sturmpioniere sind ja ganz auf sich selbst gestellt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52"
                TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>Schritt um Schritt arbeiten sich die Kompanien gegen ein Dorf vor.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53"
                TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>Die ersten Bolschewicke kommen heraus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54"
                TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>Noch aber ist der Kampf nicht entschieden. Am anderen Ende des Dorfes verteidigen sich die Sowjets um Sozea.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55"
                TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>Unsere Infanterie hat den Widerstand gebrochen. Auch diese als Bauernhäuser getarten Bunker wurden in kühnem Ansturm bezwungen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56"
                TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>Blick aus einem Bunker auf das Vorgelände, das von hier aus mit MGs weit hin beherrscht wurde. Panzerabwehrgräben, Laufgräben zwischen den Bunkern,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57"
                TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts135">
                <ANNOTATION_VALUE>Holzsperren und schwere Höckerhindernisse. Nichts konnte die deutsche Infanterie aufhalten. Hier die Spuren der bolschewistischen Niederlage.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58"
                TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>Hundert Kilometer vor Moskau. Eine Feldküche mit heißem Tee als Willkommene Beute.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59"
                TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>Vormarsch auf der Rollbahn.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60"
                TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>Selbst hier, nicht weit vor der sowjetischen Hauptstadt, sind auf die Straßen erster Ordnung in einem unbeschreiblichen Zustand.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61"
                TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>Gefangene müssen mithelfen, die Fahrbahnen notwendig in Stamm zu halten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62"
                TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>Immer wieder gibt es neuen Aufenthalt. In diesem Leben und Dreck droht alles stecken zu bleiben.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63"
                TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>Die Front wartet auf Munition und Verpflegung. Es muss geschafft werden und es wird geschafft.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64"
                TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>Unter schwersten Strapazen wird das Material nach vorn gebracht. Der Transport jeder Granate, jeden Geschosses kostet viel Schweiß und Mühe. Die Soldaten des Nachschubs vollbringen hier einzigartige Leistungen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65"
                TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>Besonders einiges Nachschubgut wird von Transportflugzeugen übernommen. Der Reisarbeitsdienst hilft beim Verladen mit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66"
                TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>Im Teeflug über die völlig verschlammten Straßen. Reibstoff für unsere Panzer.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67"
                TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>Am Südabschnitt der Front. Flug über Scharkow. Unter uns riesige Industriewerke. In Scharkow lag ein großer Teil der sowjetischen Rüstungsindustrie.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68"
                TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>Der Verlust dieser Stadt hat die Sowjets besonders schwer getroffen. Landung mitten in Scharkow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69"
                TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Unmittelbar neben den Industriepalästen stehen die elenden Lehmhütten der Arbeiter. Die von den bolschewistischen Machthabern im brutalster Weise ausgenutzt wurden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70"
                TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts165">
                <ANNOTATION_VALUE>Als Lohnsklaven hatten sie nur zu schuften. Ohne jede soziale Fürsorge vegetierten sie dahin und lebten noch schlimmer als das Vieh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71"
                TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>Mit den vorigen Truppen ist auch die Frontzeitung sofort zur Stelle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72"
                TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>Die neueste Nummer der Frontzeitung. Auch die Bevölkerung bekommt ihr Nachrichtenblatt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73"
                TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>Eine Eisenbahnbrücke über den Nieper, deren Mittelstück von den Sowjets gesprengt worden war, wird von unseren Eisenbahnpionieren wiederhergestellt. Fertige Kriegsbrückenteile werden montiert.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74"
                TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>Unsere Pionierer sind Tag und Nacht im Einsatz, um der Truppe möglichst schnell einen neuen, wichtigen Nachschubweg zu erschließen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75"
                TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>In kurzer Zeit ist das Werk vollendet, dessen Bau einst Monate und Jahre dauerte.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76"
                TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>Der Marsch der Gefangenen aus den gewaltigen Vernichtungsschlachten Ostwärts des Nieper scheint endlos. Eine besondere Auslese von Juden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77"
                TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>Dort unten wälzt sich der endlose Zug der Gefangenen Bolschewicke immer weiter nach Westen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78"
                TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>Das sind die Bundesgenossen Churchill's, die christlichen Soldaten Roosevelt's.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79"
                TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>Truppen-Transport auf dem Nieper. Auf großen Schleppkehnen geht es nach Süden, zur Küste des Schwarzen Meeres.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80"
                TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>Auf ihrer Rückfahrt nehmen die Schleppzüge verwundete deutsche Soldaten mit. Man erspart ihnen damit den beschwerlichen Transport über die verwahrlosen sovietischen Straßen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81"
                TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>Hier kann man sich noch sonnen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82"
                TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>Kampf um die Krim.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83"
                TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>Eine Radfahrschwadron im Vorrücken auf Simferopol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84"
                TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>Diese Fabrik hatten die Soviets in eine Festung verwandelt. Sie wurde von unserer Artillerie zusammengeschossen und dann von der Infanterie im Sturm genommen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85"
                TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>Und hier zwei sovietische Panzerzüge, die von Feldhabitzen, Flachartillerie und Panzerjägern vernichtet wurden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86"
                TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>Volchewistische Flieger greifen die Spitze unserer Truppen an.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87"
                TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Einer von ihnen ist abgeschossen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88"
                TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>In Bucharest, der Hauptstadt Rumäniens, fand eine Siegesparade der Odessa-Kämpfer statt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89"
                TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>König Michael dekoriert die Fahnen der siegreichen Regimenta. General Feldmaschalkaitl, der im Auftrage des Führers der Parade beiwohnte.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90"
                TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Offiziere, die sich bei der Eroberung Odessas besonders auszeichneten, werden zu Rittern des Michael-Ordens geschlagen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91"
                TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>Staatsführer Marschall Antoneski, die Sieger von Odessa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92"
                TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>Eren Formationen der deutschen Wehrmacht.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93"
                TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>Bei unseren Soldaten in Afrika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94"
                TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts225">
                <ANNOTATION_VALUE>Rommel zeichnet verdiente Männer des deutschen Afrika-Kurs aus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95"
                TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>Der Ehrentag der Kameraden ist ein Festtag für alle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96"
                TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>Es gibt Garzellenbraten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97"
                TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>Die Fliegen sind ja eine wahre Landplage.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98"
                TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>Nur langt's aber.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99"
                TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>Jetzt ist das Speisezimmer fliegenfrei.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100"
                TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>Der Kriegsberichter hat dafür Doppel zu leiden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101"
                TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>Sieben mal sieben auf einen Schlag.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102"
                TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>Die Fliegen werden weniger. Die muss das erst im Hochsommer gewesen sein.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103"
                TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts245">
                <ANNOTATION_VALUE>Im Morgengrauen brechen deutsche Panzer vor.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104"
                TIME_SLOT_REF1="ts246" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>Die vierte feindliche Transportkolonne ist gestellt und wird von unserer Artillerie unter Feuer genommen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105"
                TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>Alle Tanks, die den Rückzug der Lastkraftwagen decken sollten, werden in direkte Beschuss vernichtet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106"
                TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>Weichen zurück. Unsere Panzerkampfwagen stoßen nach.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107"
                TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>Zerschossen und brennend liegen die britischen Panzer am Vormarschweg.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108"
                TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>An der Kanalküste.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109"
                TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>Die Führer und Torpedo-Booter laufen zur Sicherung eines deutschen Geleitzugs aus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110"
                TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>Ein Teil des Geleitzugs. Sein Ziel ist ein Hafen an der französischen Atlantiküste.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111"
                TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>Im Kanalgebiet sichern auch Zerstörer zur Luft den Transport und melden schon von weit her, dass er rannah an feindlicher Streitkräfte.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112"
                TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>Im Zusammenwirken mit unseren Unterseebooten soll ein englischer Geleitzug angegriffen und zersprengt werden. Die Maschinen sind mit Bomben schwer beladen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113"
                TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>Die feindliche Küste.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114"
                TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>Geleitzug in Sicht. Maschinen klar zum Angriff.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115"
                TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Ein britisches Boardflugzeug.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116"
                TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>Der erste Frachtor wird angegriffen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117"
                TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>Wieder und wieder wird der Geleitzug angeflogen und mit Bomben und Boardwaffen bekämpft.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118"
                TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>Positionsmeldung an die Unterseeboote. Was den Bomben der Flieger entgeht, sollen sie mit ihren Torpedos vernichten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119"
                TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>Der Kampf gegen die britische Versorgungsschiffart geht unentwegt weiter. England wird seinem Schicksal nicht entgehen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
