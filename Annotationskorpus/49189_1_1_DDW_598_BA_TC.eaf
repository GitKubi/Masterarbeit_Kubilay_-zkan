        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87"
                TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>Flakartillerie beschießt die feindlichen Stellungen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
