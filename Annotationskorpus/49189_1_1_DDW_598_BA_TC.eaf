        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88"
                TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>Stukas im Angriff auf Küstenbefestigungen und Feldstellungen der Sowjets im Raume von Kertsch.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89"
                TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>Bei unseren Soldaten in Afrika.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90"
                TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>Auf der Straße nach Derna. Schnelle deutsche und italienische Verbände stoßen den weichenden Briten nach.</ANNOTATION_VALUE>
