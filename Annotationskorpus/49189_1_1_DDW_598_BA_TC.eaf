        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84"
                TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>Auch unter primitivsten Verhältnissen weiß der deutsche Infantrist sich einen Unterschlupf zu schaffen.</ANNOTATION_VALUE>
