            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79"
                TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>Deutsche, rumänische und kroatische Verbände stehen hier Schulter an Schulter im Kampf gegen</ANNOTATION_VALUE>
