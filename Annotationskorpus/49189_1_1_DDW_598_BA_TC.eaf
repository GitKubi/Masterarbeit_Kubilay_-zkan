            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83"
                TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts181">
                <ANNOTATION_VALUE>Und hier im Osten der Halbinsel Krim. Infanterie beim Stellungsbau.</ANNOTATION_VALUE>
