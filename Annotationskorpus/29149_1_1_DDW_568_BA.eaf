        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75"
                TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>Kampf mit bolschewistischen Panzern, die vergeblich versuchen, den deutschen Vormarsch aufzuhalten.</ANNOTATION_VALUE>
