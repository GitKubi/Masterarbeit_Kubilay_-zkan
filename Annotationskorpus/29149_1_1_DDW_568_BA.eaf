        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76"
                TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>Hier wurde von unserem Panzerschützen ein sowjetischer Panzerzug,</ANNOTATION_VALUE>
