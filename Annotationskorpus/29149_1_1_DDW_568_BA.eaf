                <ANNOTATION_VALUE>Vorstoß zum Jeppa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74"
                TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>Der Infanterie weit voraus übernehmen hier die Panzer die Spitze.</ANNOTATION_VALUE>
