        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35"
                TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>Alle diese Studenten sind von der Front oder aus Werkstatt und Fabrik in den Hörsaal gekommen.</ANNOTATION_VALUE>
