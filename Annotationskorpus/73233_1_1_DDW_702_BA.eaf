        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31"
                TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>Das Bild des Reichstudentenführers Dr. Scheehl. Er ist der Schöpfer des Langmarktstudiums.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32"
                TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>Die Erinnerung an Langemarkt, den todesmutigen Einsatz deutscher Studenten im ersten Weltkrieg, ist für jeden von ihnen hohe Verpflichtung.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33"
                TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>Ein Träger des Ritterkreuzes erzählt den Kameraden von seinen Erlebnissen an der Front.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34"
                TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts77">
