        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>Zusammenarbeit der deutschen und italienischen Kriegsmarine für den gemeinsamen Kampf.</ANNOTATION_VALUE>
