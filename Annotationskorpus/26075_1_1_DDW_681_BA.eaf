        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100"
                TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>In den harten Kämpfen wurden Tausende von sowjetischen Panzern abgeschossen.</ANNOTATION_VALUE>
