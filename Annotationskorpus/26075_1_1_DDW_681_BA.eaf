        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103"
                TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>Im Zuge der großzügig durchgeführten Frontbegradigungen wurden militärisch wichtige Anlagen von unseren Truppen zerstört.</ANNOTATION_VALUE>
