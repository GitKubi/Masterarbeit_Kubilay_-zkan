        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101"
                TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>Unsere tapferen Soldaten aller Waffengattungen haben die weitgesteckten Pläne des Feindes überall vereitelt.</ANNOTATION_VALUE>
