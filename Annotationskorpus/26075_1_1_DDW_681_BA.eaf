                <ANNOTATION_VALUE>Antwerpen. Der freiwillige fremische Arbeitsdienst zieht durch die Stadt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71"
                TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>Einmarsch ins Stadion von Berchem. Der Arbeitsdienst in Flandern ist nach deutschem Muster aufgebaut.</ANNOTATION_VALUE>
