    <TIER LINGUISTIC_TYPE_REF="Content_Type" PARENT_REF="Segment" TIER_ID="Content">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a173" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>Luftkrieg über Le Havre, Frankreich, 1940. Deutsche Bomber und Sturzkampfflugzeuge greifen Le Havre, eine englisch-französische Transportflotte sowie Verkehrs- und Bahnanlagen an
</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>Einmarsch in Amiens, Frankreich, 1940. Einmarsch in Oisemont, Frankreich, 1940. Deutscher Vormarsch und Einmarsch in Amiens und Oisemont, zerstörte militärische und zivile Infrastruktur, abgeschossener feindlicher Panzer sowie deutsche Soldaten bei der Versorgung zurückgebliebenen Viehs</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a175" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>Überquerung der Somme und Angriffe im Sommegebiet, Frankreich, 1940. Deutscher Angriff und Vormarsch im Sommegebiet; Artillerie- und Infanterieeinsatz, zerstörte französische Panzer, zahlreiche französische Gefangene sowie weiterer Vormarsch deutscher Truppen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>Totale Zerstörung in Fécamp, Frankreich, 1940. Generäle und Gefangene in Saint Valery, Frankreich. Eroberung von Le Havre, Frankreich. Deutscher Vormarsch über Fécamp und Saint-Valery bis Le Havre; zerstörtes alliiertes Kriegsmaterial, gefangene französische und britische Soldaten und Generäle sowie weiterer deutscher Vormarsch über die Seine in Richtung Paris</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a177" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Besetzung von Rouen, Frankreich, 1940. mpfhandlungen und Zerstörungen, französische Gefangene sowie deutsche Soldaten bei Löscharbeiten an der Kathedrale</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a178" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>Versorgung durch die Nationalsozialistische Volkswohlfahrt, Frankreich, 1940. Deutsche Soldaten und NSV versorgen die französische Zivilbevölkerung mit Lebensmitteln und Getränken</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a179" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Organisation Todt bei Aufräumarbeiten und Besuch Hitlers, Frankreich, 1940</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Bombardement auf Péronne, Frankreich, 1940. Vormarsch durch Ortschaften, Frankreich.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Durchbruch durch die Weygand-Linie, Dritte Frankreich, 1940. Zerstörte französische Befestigungen und weiterer deutscher Vormarsch in Richtung Paris</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>General Stumme macht Gefangene, Frankreich, 1940.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Gedenkstätte des deutschen Waffenstillstandes von 1918 in Compiègne, Frankreich, 1940. Deutscher Vormarsch bei Compiègne; Erinnerungsort des Waffenstillstands von 1918 wird gezeigt und ein Denkmal mit Hakenkreuzflagge bedeckt; anschließend weiterer Vormarsch Richtung Paris</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>Vormarsch, Frankreich, 1940. Deutscher Vormarsch über Chemin-des-Dames in Richtung Reims und Château-Thierry; Artillerievorbereitung und Überwindung von Flüssen, Kanälen und Schleusenanlagen</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a185" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>Übergang über die Aisne, Frankreich, 1940.  Vormarsch durch die Champagne, Frankreich. Deutsche Truppen überqueren nach dem Bau einer Pontonbrücke die Aisne und setzen ihren Vormarsch durch die Champagne fort</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a186" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>Neuchâteau, Fort Brimont, Frankreich, 1940. Deutsche Artillerie greift Reims und Fort Brimont an; das Fort wird erobert, französische Soldaten gefangen genommen und die zerstörten Befestigungen gezeigt</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a187" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>Einmarsch in Reims, Frankreich, 1940.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a188" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>Tagnon, Frankreich, 1940. Brennende Häuser und Straßensperren sowie französische Gefangene und zurückgelassenes französisches Kriegsmaterial</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>Einmarsch in Château-Thierry, Übergang über die Marne mit Panzern,  Frankreich, Generalleutnant Ritter von Speck, Kommandeur des XVIII. Armeekorps, im Gespräch mit seinen Soldaten 1940. Deutsche Truppen nehmen Château-Thierry ein und überschreiten die Marne; französische Soldaten werden gefangen genommen und deutsche Panzer setzen den Vormarsch fort</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a190" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>Einmarsch in Versailles, Frankreich, Einmarsch in Paris 1940. Hissen der Hakenkreuzflagge im Schloss Versailles. Hissen der Reichskriegsflagge auf dem Eiffelturm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a191" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>Rückblick auf die französische Nationalfeiertagsparade 14.07.1939 mit britischen Soldaten; anschließend Einmarsch und Parade deutscher Truppen durch Paris.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>Soldaten nach dem Durchbruch bei Verdun, Frankreich, 1940. Lachende deutsche Soldaten setzen nach dem erfolgreichen Durchbruch bei Verdun ihren Vormarsch fort</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
