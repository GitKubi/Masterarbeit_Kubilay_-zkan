    <TIER LINGUISTIC_TYPE_REF="imported-sub" TIER_ID="Subtitle-Tier">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts3">
                <ANNOTATION_VALUE>Hauptmann Akda vom Sprengkommando Berlin. Er entschärfte 1016 Bomben und wurde kürzlich vom</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
                <ANNOTATION_VALUE>Führer mit dem Eichenlaub ausgezeichnet. Hauptmann Akda bei der Ausgabe der Einsatzbefehle an seine</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>Männer. Wo Zeitzünder und Blindgänger Leben und Besitz gefährden, wird das Sprengkommando eingesetzt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>Hauptmann Akda bei der Unschädlichmachung eines Langzeitzünders. Akda trägt auch das goldene</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>Verwundetenabzeichen. Er wurde bei einer Bomben-Explosion schwer verletzt und war ein Jahr lang</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>völlig erblindet. Eisernen Nerven sind Vorbedingungen für das unheimliche Kriegshandwerk</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>dieser Männer. Technisches Verständnis und genaue Kenntnis der verschiedenen Bombenarten,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>die Voraussetzungen für das Gelingen. Jeder Fehlgriff kann im Bruchteil einer Sekunde das</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>Leben kosten. Panzerfaustschießen in einer deutschen Stadt. Hier kann jeder Deutsche</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>die Handhabung dieses vom Feind gefürchteten Panzer-Nabe-Kämpfungsmittels kennenlernen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>Es ist genauso einfach wie es aussieht.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>Auch Frauen können diese Waffe mit Leichtigkeit bedienen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Der Führer empfängt in seinem Hauptquartier den Reichsjugendführer Axmann mit einer Abordnung</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>von 20 Hitlerjungen, die sich bei der Verteidigung ihrer Heimat besonders bewährt haben und dafür</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>mit dem eisernen Kreuz ausgezeichnet wurden. Mit diesen 20 Jungen ist vor dem Führer symbolisch</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>die deutsche Jugend angetreten, die als treuer Helfer unserer Soldaten und des Volkssturms mutig</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17"
                TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>und unerschrocken im höchsten Einsatz steht. Der Führer lässt sich von den Jungen ihre</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>Erlebnisse schildern. Ich habe zunächst mit 13 meiner Kameraden unter dem Befehl unseres</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts43">
                <ANNOTATION_VALUE>Bandführers am Stadtrand von Hindenburg-West gelegen. Diesen sollten wir gegen einbrechende</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20"
                TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>feindliche Panzer sichern. Als diese dann aus der Richtung Gleiwitz am 24. Januar anrölten,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21"
                TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>fiel der Bandführer uns in zwei Gruppen ein und werde mit der einen gegen die Panzer folgend,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22"
                TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>um sie selbst anzugreifen, gaben wir anderen ihnen den Feuerschutz. Unser Bandführer hat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>drei Panzer abgeschossen und ist dann leider bei der Vernichtung des Vierten gefallen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24"
                TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>Nachdem wir seinen Tod festgestellt hatten, mussten wir uns aus taktischen Gründen auf</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25"
                TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>ein Eisenband am zurückziehen und dort habe ich dann am Abend die unter diesem hin durchführende</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26"
                TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>Straße von Gleiwitz nach Hindenburg, die den Zugang zur Stadt bildete, gesprengt. Ich war</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27"
                TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>bei unserem ersten Angriff als Befehl des Bandführers als Meldung eingesetzt. Ich musste eine sehr</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>wichtige Meldung zu den Sturmgeschützen zurückbringen und diese heranziehen. Diese</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29"
                TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts63">
                <ANNOTATION_VALUE>kamen dann auch nach und so ermöglichten sie uns das Eindringen vom Feindmitte zu Dorf und so</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30"
                TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>holen wir die Bereitstellung auf. Als der Russe näher an Laubern heranrückte, habe ich mich dem</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31"
                TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>Kampfkommandanten von Laubern freiwillig als Meller zur Verfügung gestellt. Meine Aufgabe stand darin,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32"
                TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts69">
                <ANNOTATION_VALUE>Meldungen zu den einzelnen Kompaniegefechtsständen zu bringen. Außerdem habe ich oftmals Panzerfäuste</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33"
                TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>und Verpflegung in die Hauptkampflinien geschafft. Die Panzerfäuste habe ich auf Leiterwagen oder</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34"
                TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>kaum unter feindlichen Beschuss in die HKL geschaffen. Der erste Ritterkreuzträger des deutschen</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35"
                TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>Volkssturms, Bataillonsführer Ernst Tiburci, erhielt diese hohe Auszeichnung für hervorragende</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36"
                TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>Einsatzbereitschaft. Durch seine Initiative wurde ein Durchstoß des Gegners in der Stadt</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37"
                TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>Indere von Königsberg verhindert. Der Kampf im Osten. Der ununterbrochene Ansturm des</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38"
                TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>bolschewistischen Gegners auf die Festung Breslau scheitert immer wieder an dem eisernen</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39"
                TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>Abwehrwillen ihrer Verteidiger. Der Führer Niederschlesiens Gauleiter Hanke, der die</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40"
                TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>Besatzung und die Bevölkerung Breslaus mit einem fanatischen Widerstandsgeist beseelt hat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41"
                TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts91">
                <ANNOTATION_VALUE>Männer und Frauen greifen mit zu, um die Stadt ständig verteidigungsbereit zu halten.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42"
                TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>Abgeschossenes Serviettpanzer in einen der schwer umkämpften Stadtteile Breslaus.</ANNOTATION_VALUE>
