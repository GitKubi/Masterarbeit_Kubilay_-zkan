        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43"
                TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>Aus der Festung Königsberg. Der Festungskommandant General Lasch. Gauleiter Koch.</ANNOTATION_VALUE>
