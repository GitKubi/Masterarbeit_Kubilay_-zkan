        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>Entschärfung, Berlin, Deutsches Reich, 1945.  Hauptmann Aghta und das Bomben-Sprengkommando Berlin bei der Einsatzvorbereitung und Entschärfung von Blindgängern</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>Volkssturm, Deutsches Reich, 1945.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>Belobigungsszene, Berlin, 1945. Hitler empfängt und belobigt Hitlerjungen für ihren Fronteinsatz. Die Jugendlichen berichten von Kämpfen gegen sowjetische Truppen, Panzervernichtung, Gefallenen sowie freiwilligen Melde- und Versorgungseinsätzen unter feindlichem Beschuss</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>Ritterkreuzträger, Deutsches Reich, 1945.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>Vorbereitung und Verteidigung Breslaus</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>Schlacht um Königsberg, 1945. Verteidigung Königsbergs durch reguläre Soldaten und Volkssturm in der zerstörten Stadt. Verwundetenversorgung und Auszeichnung von Verteidigern. Plakate rufen zum Durchhalten und zur Rache auf</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>Evakuierung, Ostsee, 1945. Die Kriegsmarine evakuiert Flüchtlinge aus Ost- und Westpreußen über die Ostsee</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>Logistik, Deutsches Reich, 1945. Militärischer Nachschub mit Panzern und Fahrzeugen in der Gefechtszone. Ein Transparent fordert zum Schutz von Frauen und Kindern vor den als „rote Bestien“ bezeichneten Gegnern auf</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>Missbrauch, Deutsches Reich, 1945. Frauen berichten in einem Interview von Vergewaltigungen und Misshandlungen durch gegnerische Soldaten, parallel werden getötete Zivilisten und Verwüstungen gezeigt</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a91">
