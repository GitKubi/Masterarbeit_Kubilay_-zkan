    <TIER LINGUISTIC_TYPE_REF="Content_Type" PARENT_REF="Segment" TIER_ID="Content">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Vorfilm: Luftschutzunterricht zur Brandbombenbekämpfung. Luftschutzwart demonstriert den Umgang mit Brandbomben, Löschgeräten und das Verhalten bei Bränden während eines Luftangriffs und ruft zur gegenseitigen Hilfe auf</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>Radländerkampf in Wangen im Allgäu, Deutsches Reich, 1940. Internationaler Radländerkampf zwischen Deutschland, Italien, Jugoslawien und Ungarn in Wangen im Allgäu vor zahlreichen Zuschauern</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a167" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>Austragung der Kanumeisterschaften am Starnberger See, Deutsches Reich, 1940</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a168" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>Deutsche Ostmesse in Königsberg, Deutsches Reich, 1940</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a187" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>Chemische Werke in Leuna, Deutsches Reich, 1940.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a188" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>Ausschlachtung erbeuteter Fahrzeuge, 1940. Erbeutete und zerstörte Fahrzeuge aus dem Frankreichfeldzug werden gesammelt, ausgeschlachtet und zur Wiederverwertung in Einzelteile und Schrott zerlegt</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a189" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>Rüstungsarbeiter besuchen Flak-Stellungen, Deutsches Reich, 1940. Rüstungsarbeiter besuchen im Rahmen der KdF-Wehrmachtsbetreuung Flakstellungen und erleben die von ihnen selbst produzierten Waffen bei Vorführung und Einsatz</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a190" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>Freizeitbeschäftigung deutscher Soldaten, Frankreich, 1940. Alltag und Freizeit deutscher Soldaten im besetzten Frankreich mit Waffen- und Kleidungspflege sowie Sport und Baden an der Küste</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a191" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>Brauchitsch besucht ein Lazarett, 1940.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>Ehrung der neuen Generalfeldmarschälle in der Reichskanzlei, Berlin, Deutsches Reich 1940. Hitler überreicht am 19.07.1940 in der Reichskanzlei Reichsmarschall Göring und den neuernannten Generalfeldmarschällen die Marschallstäbe. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>Besichtigung der militärischen Einrichtungen des italienischen Heeres, Italien, 1940</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a229" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>Einlaufendes italienisches U-Boot, Italien, 1940. Italienisches U-Boot kehrt vom Einsatz zurück und wird von Zuschauern empfangen; Symbole verweisen auf versenkte britische Schiffe</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a230" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>Bombenabwürfe über Britisch-Somaliland, 1940. Italienische Bomber werden für einen Einsatz vorbereitet und greifen britische Schiffe, Lager und Stellungen in Britisch-Somaliland an</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a231" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>Einsatz schwerer deutscher Artillerie, Frankreich, 1940</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a232" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE> Bombenabwürfe über der Insel Wight, Großbritannien, 1940</ANNOTATION_VALUE>
            </REF_ANNOTATION>
