        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141"
                TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>Häuserkampf Straße um Straße nehmen. Am 24. Juli meldete das Oberkommando der Wehrmacht aus dem</ANNOTATION_VALUE>
