    <TIER LINGUISTIC_TYPE_REF="Content_Type" PARENT_REF="Segment" TIER_ID="Content">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a163" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE> Atlantikwall, Frankreich, 1942. Darstellung der deutschen Küstenverteidigung am Atlantikwall mit Befestigungsanlagen, Artillerie-, Flak-, Luftwaffen- und Marineeinheiten sowie Verlegung und Einsatzbereitschaft von Truppen und schwerem Kriegsgerät</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>General Muñoz Grande besucht Adolf Hitler in dessen Hauptquartier, Winnyzja, Ukraine, Sowjetunion, 1942.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>Die Einnahme der Halbinsel Cherson, Krim, Sowjetunion, 1942. Angriff deutscher Luft-, Panzer- und Infanterieverbände auf sowjetische Befestigungen auf der Halbinsel Cherson</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>Russlandfeldzug, Sowjetunion, 1942.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a151" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>Deutsche Sommeroffensive an der Ostfront mit Vormarsch durch das Dongebiet bis zur Einnahme Rostows; Gefechte, Überschreiten des Don, Luftangriffe, sowjetische Verluste und Kriegsgefangene sowie Besetzung Rostows</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a152" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>Marschierende deutsche Infanterie und Panzer sowie motorisierte Truppen beim Vormarsch, musikalisch begleitet von einem führerbezogenen Marschlied</ANNOTATION_VALUE>
            </REF_ANNOTATION>
