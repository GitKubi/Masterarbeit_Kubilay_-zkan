@echo off

REM Automatic transcription of MP4 files using OpenAI Whisper
REM Language: German
REM Model: medium
REM Output: SRT subtitles

for %%f in (*.mp4) do (
    if not exist "%%~nf.srt" (
        echo Transcribing: %%f
        whisper "%%f" --language German --model medium --output_format srt
    ) else (
        echo Skipping: %%f - SRT already exists
    )
)

echo.
echo Transcription completed.
pause
